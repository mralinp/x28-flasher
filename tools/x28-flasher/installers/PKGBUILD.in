# Generated by CI with the release version and source archive checksum.
pkgname=x28-flasher
pkgver=@VERSION@
pkgrel=1
pkgdesc='Back up, build and flash the ZLT X28 5G modem over USB'
arch=('x86_64')
# A prebuilt bundle: stripping would corrupt the PyInstaller executable, and no -debug package must be split off (CI picked it up).
options=('!strip' '!debug')
url='https://github.com/mralinp/x28-flasher'
license=('GPL-3.0-only')
depends=(
  'gtk3'
  'hicolor-icon-theme'
  'libusb'
  'openssh'
  'python'
  'python-gobject'
  'webkit2gtk-4.1'
)
optdepends=(
  'docker: Build from my backup and Root access features'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/mralinp/x28-flasher/releases/download/v${pkgver}/X28-Flasher-linux-x86_64.tar.gz"
)
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/opt/x28-flasher"
  cp -a "$srcdir/x28-flasher/." "$pkgdir/opt/x28-flasher/"
  install -Dm755 "$srcdir/x28-flasher-window" "$pkgdir/opt/x28-flasher/x28-flasher-window"
  install -Dm755 "$srcdir/x28-flasher.sh" "$pkgdir/usr/bin/x28-flasher"
  install -Dm644 "$srcdir/x28-flasher.desktop" "$pkgdir/usr/share/applications/x28-flasher.desktop"
  install -Dm644 "$srcdir/x28-flasher.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/x28-flasher.png"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
