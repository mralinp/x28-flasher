#!/bin/sh
# Opening this app starts the flasher in the background and shows its page in your browser. Opening it again just shows
# the page that is already up. Quit it from the page. Log: ~/Library/Logs/x28-flasher.log
root="$(cd "$(dirname "$0")/../../.." && pwd)"
PATH="/opt/homebrew/bin:/usr/local/bin:/Library/Frameworks/Python.framework/Versions/Current/bin:$PATH"
for py in python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  p=$(command -v "$py") || continue
  "$p" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null || continue
  mkdir -p "$HOME/Library/Logs"
  exec "$p" "$root/tools/x28-flasher/x28_flasher.py" >>"$HOME/Library/Logs/x28-flasher.log" 2>&1
done
osascript -e 'display dialog "X28 Flasher needs Python 3.10 or newer. Install it from python.org, then open the app again." buttons {"OK"} default button "OK" with icon caution'
